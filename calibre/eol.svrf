// ============================================================================
//  EOL spacing rule deck for Calibre nmDRC  --  DRAFT
//  Not run on a real Calibre yet: check the syntax against the SVRF manual
//  (svrf_ur.pdf) on the server.
//
//  Same rule as the C++ checker:
//    EOL edge   : edge <= 0.6 with convex corners at both ends
//    violation  : metal in the EOL spacing region: EOLSpacing 1.0 in front of
//                 the end, EOLWithin 0.4 wider on each side
//    The spec's parallel condition (0.4 beside the end, 0.7 back) is not
//    used: every EOL edge is checked.
// ============================================================================

LAYOUT PATH    "tc00_sample.gds"
LAYOUT PRIMARY "TOP"
LAYOUT SYSTEM  GDSII
PRECISION      1000

DRC RESULTS DATABASE "eol_results.db" ASCII
DRC SUMMARY REPORT   "eol_summary.rep"
DRC MAXIMUM RESULTS  ALL

LAYER M1 1

// 1. line ends: edges of M1 no longer than 0.6 whose both corners are convex
EOL_EDGE = CONVEX EDGE M1 ANGLE1 == 90 ANGLE2 == 90 WITH LENGTH <= 0.6

// 2. violation: metal closer than 1.0 in front of the line end,
//    the measured region 0.4 wider on each side
M1.EOL.1 {
  @ M1 end-of-line spacing < 1.0 um (end <= 0.6, eolWithin 0.4)
  EXT EOL_EDGE M1 < 1.0 OPPOSITE EXTENDED 0.4 REGION
}
